# Copy values you need into workers/api/.dev.vars — never commit real secrets.
# Generate encryption / session material with:
#   openssl rand -hex 32

# Oura OAuth (Cloudflare Worker secrets / .dev.vars)
OURA_CLIENT_ID=
OURA_CLIENT_SECRET=

# Must exactly match a Redirect URI on the Oura API application.
# Local Vite (recommended): callback goes through the /api proxy so the session cookie is set on :5173
OURA_REDIRECT_URI=http://localhost:5173/api/auth/oura/callback

# Where the Worker sends the browser after OAuth (no trailing slash)
FRONTEND_ORIGIN=http://localhost:5173

# Encrypt refresh tokens at rest — 32-byte hex (64 chars) or base64
TOKEN_ENCRYPTION_KEY=

# HMAC for the oura_session cookie
SESSION_SECRET=
