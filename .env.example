# Oura OAuth (Cloudflare Worker secrets / .dev.vars — never commit real values)
OURA_CLIENT_ID=
OURA_CLIENT_SECRET=
OURA_REDIRECT_URI=http://localhost:8787/api/auth/oura/callback

# Encrypt refresh tokens at rest (32-byte hex or base64)
TOKEN_ENCRYPTION_KEY=

# Session cookie signing
SESSION_SECRET=
